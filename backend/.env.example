# Copy to .env for local dev; set these as real env vars in production.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=America/Sao_Paulo

# Leave unset for SQLite. In production set the host's Postgres URL:
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Claim notifications. With EMAIL_HOST unset, emails print to the console instead.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=Registry <you@gmail.com>
