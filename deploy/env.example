# Copy to /opt/enxoval/.env on the VM and fill in. Never commit the real one.

# --- what to run ------------------------------------------------------------
# Lowercase, matching your GitHub repo. The deploy workflow rewrites IMAGE_TAG.
IMAGE=ghcr.io/your-github-user/enxoval
IMAGE_TAG=latest

# --- where it lives ---------------------------------------------------------
# The domain whose A record points at this VM. Caddy gets the certificate for it.
SITE_DOMAIN=enxoval.example.com

# --- secrets ----------------------------------------------------------------
# Generate both:  openssl rand -base64 48
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=

# --- e-mail (claim notifications) -------------------------------------------
# Leave EMAIL_HOST empty and notifications print to the container log instead of
# sending. Reservations are saved either way. Gmail needs an App Password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Enxoval <no-reply@example.com>

# --- optional ---------------------------------------------------------------
DJANGO_TIME_ZONE=America/Sao_Paulo
# Set to 0 only if this domain must also answer over plain http.
DJANGO_HSTS_SECONDS=31536000
