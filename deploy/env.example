# Copy to /opt/enxoval/.env on the VM and fill in. Never commit the real one.

# --- what to run ------------------------------------------------------------
# Lowercase, matching your GitHub repo. The deploy workflow rewrites IMAGE_TAG.
IMAGE=ghcr.io/jakeymac/enxoval-do-moroni
IMAGE_TAG=latest

# --- where it lives ---------------------------------------------------------
# The domain whose A record points at this VM. Caddy gets the certificate for it,
# and also serves www.<this> as a redirect. Cloudflare must be DNS-only (grey
# cloud) — see DJANGO_NUM_PROXIES below if you ever switch the proxy on.
SITE_DOMAIN=enxoval-do-moroni.com

# --- secrets ----------------------------------------------------------------
# Generate both:  openssl rand -base64 48
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=

# --- e-mail (claim notifications) -------------------------------------------
# Leave EMAIL_HOST empty and notifications print to the container log instead of
# sending. Reservations are saved either way. Gmail needs an App Password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Enxoval do Moroni <no-reply@enxoval-do-moroni.com>

# --- optional ---------------------------------------------------------------
DJANGO_TIME_ZONE=America/Sao_Paulo

# How many proxies sit in front of Django. The claim rate limit keys on the IP
# the closest proxy reports, so this has to match reality or the limit is either
# bypassable or shared by everyone.
#   1  Caddy only — correct for Cloudflare in DNS-only mode (grey cloud)
#   2  Caddy behind Cloudflare's proxy (orange cloud)
DJANGO_NUM_PROXIES=1
# Set to 0 only if this domain must also answer over plain http.
DJANGO_HSTS_SECONDS=31536000
