# Caddy gets and renews the Let's Encrypt certificate on its own. The only
# requirement is that SITE_DOMAIN's A record points at this VM and that
# ports 80 and 443 are open — port 80 is how the certificate is validated.

{$SITE_DOMAIN} {
	encode zstd gzip

	# No security headers set here on purpose. Django already sends them, HSTS
	# included: it sees X-Forwarded-Proto from this proxy, so request.is_secure()
	# is true and SECURE_HSTS_SECONDS applies. Setting it here too sent the
	# header twice. DJANGO_HSTS_SECONDS in .env is the one knob.
	reverse_proxy web:8000

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
